# Configuración web de Firebase, usada en tiempo de BUILD por src/App.jsx.
# Copia este archivo a .env y rellena los valores del proyecto.
#
# Estas claves son PÚBLICAS por diseño: viajan dentro del bundle que se descarga
# el navegador. Lo que protege los datos son las reglas de firestore.rules.
#
# NUNCA pongas aquí (ni en el repositorio):
#   - claves de cuenta de servicio de Firebase
#   - la clave de la API de Anthropic (se introduce en Asesor IA → Configuración
#     y se guarda solo en el dispositivo del administrador)

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=

# Opcionales: si se omiten se deducen o se dejan vacíos.
# VITE_FIREBASE_AUTH_DOMAIN=<projectId>.firebaseapp.com
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
